.panos_credentials
*_credentials
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.json

# User data (provided via volumes at runtime)
user-template/
data/

# Documentation (not needed in runtime image)
docs/
*.md
LICENSE

# OS files
.DS_Store
Thumbs.db

# Logs and databases (runtime only)
*.log
*.db
*.db-shm
*.db-wal
