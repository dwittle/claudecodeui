# Simple Worker Container for CloudCLI Multi-User Mode
# Based on Node.js with CloudCLI installed

FROM node:22-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Create agent user
RUN useradd -m -s /bin/bash agent && \
    echo "agent ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Install CloudCLI globally as root
RUN npm install -g @cloudcli-ai/cloudcli

# Switch to agent user
USER agent
WORKDIR /home/agent

# Create workspace directory
RUN mkdir -p /home/agent/workspace

# Expose port (will be overridden by container manager)
EXPOSE 4001

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:${SERVER_PORT:-4001}/api/health || exit 1

# Start CloudCLI server
CMD ["sh", "-c", "cloudcli"]
