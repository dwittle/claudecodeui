# PAN-OS Credentials Template
# Copy this to ~/.panos_credentials and set permissions to 600
#
# Installation:
#   cp credentials.template ~/.panos_credentials
#   chmod 600 ~/.panos_credentials
#   # Edit ~/.panos_credentials with your credentials
#
# Usage:
#   source ~/.panos_credentials
#   panos show <hostname> "show system info"
#

# Required: PAN-OS firewall credentials
export PANOS_USERNAME='admin'
export PANOS_PASSWORD='your-panos-password-here'

# Optional: Bastion/jump host for SSH tunneling
# Uncomment and set if you need to connect through a bastion host
# export PANOS_BASTION_HOST='netprod0001'

# Optional: Bastion host credentials
# Use NETSWITCH_* if your bastion is a network switch, or PANOS_BASTION_* for other bastions
# The tool will try NETSWITCH credentials first, then fall back to PANOS_BASTION
# export NETSWITCH_USERNAME='your-bastion-username'
# export NETSWITCH_PASSWORD='your-bastion-password'
# OR
# export PANOS_BASTION_USERNAME='your-bastion-username'
# export PANOS_BASTION_PASSWORD='your-bastion-password'
