# PAN-OS Credentials Template
# Copy this to ~/.panos_credentials and set permissions to 600
#
# Installation:
#   cp credentials.template ~/.panos_credentials
#   chmod 600 ~/.panos_credentials
#   # Edit ~/.panos_credentials with your credentials
#

export PANOS_PASSWORD='your-panos-password-here'
export PANOS_USERNAME='admin'

# Optional: Bastion/jump host for SSH tunneling
# Default is 'netprod0001' - uncomment to override
# export PANOS_BASTION_HOST='netprod0001'
