#!/usr/bin/env bash
# Wrapper script for panos skill
# Always uses the virtual environment

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Set default bastion host if not already set
export PANOS_BASTION_HOST="${PANOS_BASTION_HOST:-netprod0001}"

# Run the CLI with the venv python using unbuffered mode (-u)
# This ensures output is immediately flushed and captured
exec "$SCRIPT_DIR/.venv/bin/python3" -u "$SCRIPT_DIR/panos_cli.py" "$@"
