# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000

# =============================================================================
# MULTI-USER CONTAINER CONFIGURATION
# =============================================================================

# Enable multi-user container mode (true/false)
# When false, runs in single-user mode (legacy behavior)
MULTI_USER_MODE=true

# Container Runtime Selection
# Options: 'auto' (default), 'docker', 'podman'
# 'auto' will detect and use the first available runtime
CONTAINER_RUNTIME=auto

# Docker/Podman socket connection
# Docker (Linux/Mac): unix:///var/run/docker.sock
# Podman rootful: unix:///run/podman/podman.sock
# Podman rootless: unix:///run/user/$UID/podman/podman.sock
# TCP connection: tcp://localhost:2375
# Leave empty for auto-detection
DOCKER_HOST=

# Alternative: Podman-specific socket override (optional)
# Only needed if auto-detection fails
# PODMAN_SOCKET_PATH=/run/user/1000/podman/podman.sock

# Auto-enable Podman socket for rootless mode (true/false)
# When true, attempts to start the Podman socket service automatically
ENABLE_PODMAN_SOCKET=true

# Container configuration
# IMPORTANT: Choose the appropriate base image for your deployment:
#
# Local development (build images locally):
# CONTAINER_BASE_IMAGE=cloudcliai/worker:latest
#
# GitLab Container Registry (production deployment):
# CONTAINER_BASE_IMAGE=registry.gitlab.com/your-org/your-project/worker:latest
#
# Docker Hub or other registry:
# CONTAINER_BASE_IMAGE=your-registry.com/your-org/worker:latest
#
CONTAINER_BASE_IMAGE=cloudcliai/worker:latest

# Port range for user containers
# Range determines maximum concurrent users: 4001-5000 = 1000 users
CONTAINER_PORT_START=4001
CONTAINER_PORT_END=5000

# Resource limits per user container
# Adjust based on your server capacity and expected usage
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_CPU_LIMIT=1.0

# Container lifecycle
CONTAINER_STOP_ON_LOGOUT=false

# =============================================================================
# CREDENTIAL ENCRYPTION (REQUIRED FOR MULTI-USER MODE!)
# =============================================================================

# Master encryption key for credential storage
# CRITICAL: Generate a secure random key and keep it secret!
# Generate with: openssl rand -hex 32
#
# WARNING: Changing this key will make existing credentials unreadable.
#          Back up your database before rotating keys.
#
# Example generation:
# ENCRYPTION_MASTER_KEY=$(openssl rand -hex 32)
#
# For production, generate once and store securely:
# export ENCRYPTION_MASTER_KEY=$(openssl rand -hex 32)
# echo "ENCRYPTION_MASTER_KEY=$ENCRYPTION_MASTER_KEY" >> .env
#
ENCRYPTION_MASTER_KEY=your-random-64-character-string-here-change-this-in-production

# =============================================================================
# DEPLOYMENT EXAMPLES
# =============================================================================
#
# Local Development:
# ------------------
# MULTI_USER_MODE=true
# CONTAINER_RUNTIME=auto
# CONTAINER_BASE_IMAGE=cloudcliai/worker:latest
# ENCRYPTION_MASTER_KEY=$(openssl rand -hex 32)
#
# GitLab Registry (RHEL8 Production):
# ------------------------------------
# MULTI_USER_MODE=true
# CONTAINER_RUNTIME=podman
# CONTAINER_BASE_IMAGE=registry.gitlab.com/your-org/cloudcli/worker:latest
# DOCKER_HOST=unix://${XDG_RUNTIME_DIR}/podman/podman.sock
# ENABLE_PODMAN_SOCKET=true
# ENCRYPTION_MASTER_KEY=<your-generated-key>
#
# Docker Hub Production:
# ----------------------
# MULTI_USER_MODE=true
# CONTAINER_RUNTIME=docker
# CONTAINER_BASE_IMAGE=yourorg/cloudcli-worker:latest
# DOCKER_HOST=unix:///var/run/docker.sock
# ENCRYPTION_MASTER_KEY=<your-generated-key>
#
# See documentation:
# - Local: LOCAL_DEVELOPMENT.md
# - RHEL8: DEPLOY_RHEL8.md
# - All options: docs/DEPLOYMENT_OPTIONS.md


